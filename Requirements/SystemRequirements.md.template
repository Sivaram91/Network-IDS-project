<script>
// Requirements data will be loaded here
let allRequirements = [];

// Load requirements from embedded CSV data
const requirementsData = `CSV_DATA_PLACEHOLDER`;

// Parse CSV
function parseCSV(csv) {
  const lines = csv.trim().split('\n');
  const headers = lines[0].split(',');
  const data = [];
  
  for (let i = 1; i < lines.length; i++) {
    const obj = {};
    let currentField = '';
    let inQuotes = false;
    let fieldIndex = 0;
    
    for (let j = 0; j < lines[i].length; j++) {
      const char = lines[i][j];
      
      if (char === '"') {
        inQuotes = !inQuotes;
      } else if (char === ',' && !inQuotes) {
        obj[headers[fieldIndex]] = currentField.trim();
        currentField = '';
        fieldIndex++;
      } else {
        currentField += char;
      }
    }
    obj[headers[fieldIndex]] = currentField.trim();
    data.push(obj);
  }
  
  return data;
}

allRequirements = parseCSV(requirementsData);

// Get unique values for filters
function getUniqueValues(field) {
  return [...new Set(allRequirements.map(req => req[field]))].filter(Boolean).sort();
}

// Populate filter dropdowns
function populateFilters() {
  const typeFilter = document.getElementById('filter-type');
  const priorityFilter = document.getElementById('filter-priority');
  const statusFilter = document.getElementById('filter-status');
  const phaseFilter = document.getElementById('filter-phase');
  const featureFilter = document.getElementById('filter-feature');
  
  getUniqueValues('Type').forEach(value => {
    const option = document.createElement('option');
    option.value = value;
    option.textContent = value;
    typeFilter.appendChild(option);
  });
  
  ['Critical', 'High', 'Medium', 'Low'].forEach(value => {
    const option = document.createElement('option');
    option.value = value;
    option.textContent = value;
    priorityFilter.appendChild(option);
  });
  
  getUniqueValues('Status').forEach(value => {
    const option = document.createElement('option');
    option.value = value;
    option.textContent = value;
    statusFilter.appendChild(option);
  });
  
  getUniqueValues('Phase').forEach(value => {
    const option = document.createElement('option');
    option.value = value;
    option.textContent = value;
    phaseFilter.appendChild(option);
  });
  
  getUniqueValues('Feature').forEach(value => {
    const option = document.createElement('option');
    option.value = value;
    option.textContent = value.replace(/_/g, ' ');
    featureFilter.appendChild(option);
  });
}

// Get badge class based on value
function getBadgeClass(type, value) {
  const normalized = value.toLowerCase().replace(/[^a-z]/g, '');
  
  if (type === 'priority') {
    return `badge badge-${normalized}`;
  } else if (type === 'type') {
    return `badge badge-${normalized}`;
  } else if (type === 'status') {
    return `badge badge-${normalized}`;
  }
  
  return 'badge';
}

// Render requirements table
function renderRequirements(requirements) {
  const tbody = document.getElementById('requirements-tbody');
  tbody.innerHTML = '';
  
  requirements.forEach(req => {
    const row = document.createElement('tr');
    row.innerHTML = `
      <td data-label="REQ ID:" class="req-id">${req.REQ_ID}</td>
      <td data-label="Description:" class="description">${req.Description}</td>
      <td data-label="Type:"><span class="${getBadgeClass('type', req.Type)}">${req.Type}</span></td>
      <td data-label="Priority:"><span class="${getBadgeClass('priority', req.Priority)}">${req.Priority}</span></td>
      <td data-label="Status:"><span class="${getBadgeClass('status', req.Status)}">${req.Status}</span></td>
      <td data-label="Feature:">${req.Feature.replace(/_/g, ' ').replace(/^\d+_/, '')}</td>
      <td data-label="Phase:">${req.Phase}</td>
      <td data-label="Details:"><button class="details-btn" onclick="showDetails('${req.REQ_ID}')">Details</button></td>
    `;
    tbody.appendChild(row);
  });
  
  document.getElementById('results-count').textContent = 
    `Showing ${requirements.length} of ${allRequirements.length} requirements`;
}

// Show requirement details in modal
function showDetails(reqId) {
  const req = allRequirements.find(r => r.REQ_ID === reqId);
  if (!req) return;
  
  const modal = document.getElementById('detail-modal');
  const modalBody = document.getElementById('modal-body');
  
  modalBody.innerHTML = `
    <h2>${req.REQ_ID}</h2>
    
    <div class="detail-section">
      <h3>Description</h3>
      <p>${req.Description}</p>
    </div>
    
    <div class="detail-grid">
      <div class="detail-item">
        <strong>Type</strong>
        <span class="${getBadgeClass('type', req.Type)}">${req.Type}</span>
      </div>
      <div class="detail-item">
        <strong>Priority</strong>
        <span class="${getBadgeClass('priority', req.Priority)}">${req.Priority}</span>
      </div>
      <div class="detail-item">
        <strong>Status</strong>
        <span class="${getBadgeClass('status', req.Status)}">${req.Status}</span>
      </div>
      <div class="detail-item">
        <strong>Phase</strong>
        ${req.Phase}
      </div>
    </div>
    
    <div class="detail-section">
      <h3>Classification</h3>
      <div class="detail-grid">
        <div class="detail-item">
          <strong>Domain</strong>
          ${req.Domain}
        </div>
        <div class="detail-item">
          <strong>Feature</strong>
          ${req.Feature.replace(/_/g, ' ')}
        </div>
      </div>
    </div>
    
    <div class="detail-section">
      <h3>Verification</h3>
      <p><strong>Method:</strong> ${req.Verification_Method}</p>
      <p><strong>Criteria:</strong> ${req.Verification_Criteria}</p>
      <p><strong>Status:</strong> ${req.Verification_Status}</p>
    </div>
    
    <div class="detail-section">
      <h3>Traceability</h3>
      <div class="detail-grid">
        <div class="detail-item">
          <strong>Architecture</strong>
          ${req.Traces_To_Arch}
        </div>
        <div class="detail-item">
          <strong>Software</strong>
          ${req.Traces_To_SW}
        </div>
        <div class="detail-item">
          <strong>Test</strong>
          ${req.Traces_To_Test}
        </div>
      </div>
    </div>
    
    <div class="detail-section">
      <h3>Rationale</h3>
      <p>${req.Rationale}</p>
    </div>
  `;
  
  modal.style.display = 'block';
}

// Filter requirements
function filterRequirements() {
  const searchTerm = document.getElementById('search-box').value.toLowerCase();
  const typeFilter = document.getElementById('filter-type').value;
  const priorityFilter = document.getElementById('filter-priority').value;
  const statusFilter = document.getElementById('filter-status').value;
  const phaseFilter = document.getElementById('filter-phase').value;
  const featureFilter = document.getElementById('filter-feature').value;
  
  const filtered = allRequirements.filter(req => {
    const matchesSearch = !searchTerm || 
      req.REQ_ID.toLowerCase().includes(searchTerm) ||
      req.Description.toLowerCase().includes(searchTerm) ||
      req.Rationale.toLowerCase().includes(searchTerm);
    
    const matchesType = !typeFilter || req.Type === typeFilter;
    const matchesPriority = !priorityFilter || req.Priority === priorityFilter;
    const matchesStatus = !statusFilter || req.Status === statusFilter;
    const matchesPhase = !phaseFilter || req.Phase === phaseFilter;
    const matchesFeature = !featureFilter || req.Feature === featureFilter;
    
    return matchesSearch && matchesType && matchesPriority && 
           matchesStatus && matchesPhase && matchesFeature;
  });
  
  renderRequirements(filtered);
}

// Clear all filters
function clearFilters() {
  document.getElementById('search-box').value = '';
  document.getElementById('filter-type').value = '';
  document.getElementById('filter-priority').value = '';
  document.getElementById('filter-status').value = '';
  document.getElementById('filter-phase').value = '';
  document.getElementById('filter-feature').value = '';
  filterRequirements();
}

// Initialize
document.addEventListener('DOMContentLoaded', function() {
  populateFilters();
  renderRequirements(allRequirements);
  
  // Add event listeners
  document.getElementById('search-box').addEventListener('input', filterRequirements);
  document.getElementById('filter-type').addEventListener('change', filterRequirements);
  document.getElementById('filter-priority').addEventListener('change', filterRequirements);
  document.getElementById('filter-status').addEventListener('change', filterRequirements);
  document.getElementById('filter-phase').addEventListener('change', filterRequirements);
  document.getElementById('filter-feature').addEventListener('change', filterRequirements);
  document.getElementById('clear-filters').addEventListener('click', clearFilters);
  
  // Modal close handlers
  document.querySelector('.close').addEventListener('click', function() {
    document.getElementById('detail-modal').style.display = 'none';
  });
  
  window.addEventListener('click', function(event) {
    const modal = document.getElementById('detail-modal');
    if (event.target === modal) {
      modal.style.display = 'none';
    }
  });
});

// Make showDetails available globally
window.showDetails = showDetails;
</script>
