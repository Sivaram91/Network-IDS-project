@startuml
!define RECTANGLE class

package "Main ECU" {
    [Microcontroller]
    [Power Supply]
    [CAN Transceiver]
}

package "Sensors" {
    [Sensor 1]
    [Sensor 2]
    [Sensor 3]
}

package "Actuators" {
    [Actuator 1]
    [Actuator 2]
}

[Microcontroller] -- [CAN Transceiver]
[Sensor 1] --> [Microcontroller] : Analog/Digital
[Sensor 2] --> [Microcontroller] : I2C/SPI
[Microcontroller] --> [Actuator 1] : PWM
[Microcontroller] --> [Actuator 2] : GPIO

[CAN Transceiver] -- [CAN Bus]
@enduml